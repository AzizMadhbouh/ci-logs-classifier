# ---- /etc/systemd/system/ci-build-watcher.service ----
[Unit]
Description=CI Build Watcher (ingests new Jenkins builds into Postgres)
After=network-online.target docker.service postgresql.service
Wants=network-online.target docker.service postgresql.service

[Service]
Type=simple
User=appuser
Group=appuser
WorkingDirectory=/opt/sales-analyzer
EnvironmentFile=/opt/sales-analyzer/.env
ExecStart=/opt/sales-analyzer/.venv/bin/python watch_builds.py --interval 30
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ci-build-watcher

# Resource limits
MemoryMax=1G
CPUQuota=200%

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sales-analyzer/logs

[Install]
WantedBy=multi-user.target